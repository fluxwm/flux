autostart {
    spawn "swaybg" "-c" "253033"
    // spawn "waybar"
    // spawn "mako"
}

environment {
    // QT_QPA_PLATFORM "wayland;xcb"
}

input {
    keyboard {
        // layout "us"
        // variant ""
        // options ""
        // model ""
        // rules ""

        // repeat-rate 25
        // repeat-delay 600

        numlock
    }

    mouse {
        // natural-scroll
        // accel-speed 0.0
        // accel-profile "adaptive"
    }

    touchpad {
        tap-to-click
        natural-scroll
        // accel-speed 0.0
        // accel-profile "adaptive"
    }
}

/-output "eDP-1" {
    // off
    mode "1920x1080@60.00"
    scale 1.0
    transform "normal"
    position 0 0
}

gestures {
    workspace-swipe
}

cursor {
    // theme "default"
    // size 24
}

layout {
    mode "master"

    gaps {
        inner 16
        outer 16
        // smart
    }

    border {
        width 2
        active-color "#7fc8ff"
        inactive-color "#333333"
    }
}

animations {
    // off
    // slowdown 1.0
}

binds {
    Mod+Shift+Return  { spawn "kitty"; }
    Mod+D             { spawn "fuzzel"; }

    Mod+Shift+Q       { close-window; }
    Alt+F4            { close-window; }
    Alt+Tab           { cycle-window; }
    Mod+V             { toggle-floating; }
    Mod+M             { maximize-window; }
    F11               { fullscreen-window; }

    Mod+Left          { focus-window "left"; }
    Mod+Down          { focus-window "down"; }
    Mod+Up            { focus-window "up"; }
    Mod+Right         { focus-window "right"; }
    Mod+H             { focus-window "left"; }
    Mod+J             { focus-window "down"; }
    Mod+K             { focus-window "up"; }
    Mod+L             { focus-window "right"; }

    Mod+Shift+Left    { swap-window "left"; }
    Mod+Shift+Down    { swap-window "down"; }
    Mod+Shift+Up      { swap-window "up"; }
    Mod+Shift+Right   { swap-window "right"; }
    Mod+Shift+H       { swap-window "left"; }
    Mod+Shift+J       { swap-window "down"; }
    Mod+Shift+K       { swap-window "up"; }
    Mod+Shift+L       { swap-window "right"; }

    Mod+1             { focus-workspace 1; }
    Mod+2             { focus-workspace 2; }
    Mod+3             { focus-workspace 3; }
    Mod+4             { focus-workspace 4; }
    Mod+5             { focus-workspace 5; }
    Mod+6             { focus-workspace 6; }
    Mod+7             { focus-workspace 7; }
    Mod+8             { focus-workspace 8; }
    Mod+9             { focus-workspace 9; }

    Mod+Shift+1       { move-window-to-workspace 1; }
    Mod+Shift+2       { move-window-to-workspace 2; }
    Mod+Shift+3       { move-window-to-workspace 3; }
    Mod+Shift+4       { move-window-to-workspace 4; }
    Mod+Shift+5       { move-window-to-workspace 5; }
    Mod+Shift+6       { move-window-to-workspace 6; }
    Mod+Shift+7       { move-window-to-workspace 7; }
    Mod+Shift+8       { move-window-to-workspace 8; }
    Mod+Shift+9       { move-window-to-workspace 9; }

    // Volume controls (PipeWire / WirePlumber)
    XF86AudioRaiseVolume repeat locked { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+" "-l" "1.0"; }
    XF86AudioLowerVolume repeat locked { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-" "-l" "1.0"; }
    XF86AudioMute               locked { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute            locked { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }

    // Media playback (MPRIS / playerctl)
    XF86AudioPlay  locked { spawn "playerctl" "play-pause"; }
    XF86AudioPause locked { spawn "playerctl" "play-pause"; }
    XF86AudioStop  locked { spawn "playerctl" "stop"; }
    XF86AudioPrev  locked { spawn "playerctl" "previous"; }
    XF86AudioNext  locked { spawn "playerctl" "next"; }

    // Brightness controls (brightnessctl)
    XF86MonBrightnessUp   repeat locked { spawn "brightnessctl" "-n1" "-e4" "set" "+5%"; }
    XF86MonBrightnessDown repeat locked { spawn "brightnessctl" "-n1" "-e4" "set" "5%-"; }

    Ctrl+Alt+Delete   { quit; }
}
