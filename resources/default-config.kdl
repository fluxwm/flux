autostart {
    spawn "swaybg" "-c" "253033"
    // spawn "waybar"
    // spawn "mako"
}

environment {
    // QT_QPA_PLATFORM "wayland;xcb"
}

input {
    keyboard {
        // layout "us"
        // variant ""
        // options ""
        // model ""
        // rules ""

        // repeat-rate 25
        // repeat-delay 600

        numlock
    }

    touchpad {
        tap-to-click
        natural-scroll
    }
}

cursor {
    // theme "default"
    // size 24
}

layout {
    mode "master"

    gaps {
        inner 16
        outer 16
        // smart
    }
}

binds {
    Super+Shift+Return  { spawn "kitty"; }
    Super+D             { spawn "fuzzel"; }

    Super+Shift+Q       { close-window; }
    Alt+F4              { close-window; }
    Alt+Tab             { cycle-window; }
    Super+V             { toggle-floating; }
    Super+M             { maximize-window; }
    F11                 { fullscreen-window; }

    Super+Left          { focus-window "left"; }
    Super+Down          { focus-window "down"; }
    Super+Up            { focus-window "up"; }
    Super+Right         { focus-window "right"; }
    Super+H             { focus-window "left"; }
    Super+J             { focus-window "down"; }
    Super+K             { focus-window "up"; }
    Super+L             { focus-window "right"; }

    Super+1             { focus-workspace 1; }
    Super+2             { focus-workspace 2; }
    Super+3             { focus-workspace 3; }
    Super+4             { focus-workspace 4; }
    Super+5             { focus-workspace 5; }
    Super+6             { focus-workspace 6; }
    Super+7             { focus-workspace 7; }
    Super+8             { focus-workspace 8; }
    Super+9             { focus-workspace 9; }

    Super+Shift+1       { move-window-to-workspace 1; }
    Super+Shift+2       { move-window-to-workspace 2; }
    Super+Shift+3       { move-window-to-workspace 3; }
    Super+Shift+4       { move-window-to-workspace 4; }
    Super+Shift+5       { move-window-to-workspace 5; }
    Super+Shift+6       { move-window-to-workspace 6; }
    Super+Shift+7       { move-window-to-workspace 7; }
    Super+Shift+8       { move-window-to-workspace 8; }
    Super+Shift+9       { move-window-to-workspace 9; }

    // Volume controls (PipeWire / WirePlumber)
    XF86AudioRaiseVolume  { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+" "-l" "1.0"; }
    XF86AudioLowerVolume  { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-" "-l" "1.0"; }
    XF86AudioMute         { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute      { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }

    // Media playback (MPRIS / playerctl)
    XF86AudioPlay         { spawn "playerctl" "play-pause"; }
    XF86AudioPause        { spawn "playerctl" "play-pause"; }
    XF86AudioStop         { spawn "playerctl" "stop"; }
    XF86AudioPrev         { spawn "playerctl" "previous"; }
    XF86AudioNext         { spawn "playerctl" "next"; }

    // Brightness controls (brightnessctl)
    XF86MonBrightnessUp   { spawn "brightnessctl" "-e4" "set" "+5%"; }
    XF86MonBrightnessDown { spawn "brightnessctl" "-e4" "set" "5%-"; }
    XF86KbdBrightnessUp   { spawn "brightnessctl" "-d" "*kbd_backlight*" "set" "+10%"; }
    XF86KbdBrightnessDown { spawn "brightnessctl" "-d" "*kbd_backlight*" "set" "10%-"; }

    Ctrl+Alt+Delete     { quit; }
}
